# ==============================================================================
# StandBharat Backend Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SYSTEM & SECURITY
# ------------------------------------------------------------------------------
# In production, set to "production" and supply a cryptographically secure 64-char key
ENVIRONMENT=development
PROJECT_NAME="StandBharat API"
SECRET_KEY="dev-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed Frontend Origins (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. DATABASE (SQLite for Dev vs PostgreSQL for Prod)
# ------------------------------------------------------------------------------
# Development default: local SQLite
DATABASE_URL="sqlite:///./standbharat_local.db"

# Production PostgreSQL (uncomment and fill for live deployment):
# POSTGRES_USER="standbharat_user"
# POSTGRES_PASSWORD="your_strong_password"
# POSTGRES_HOST="localhost"
# POSTGRES_PORT=5432
# POSTGRES_DB="standbharat_db"
# DATABASE_URL="postgresql://standbharat_user:your_strong_password@localhost:5432/standbharat_db"

# Database Credential Encryption Key (Optional in dev; recommended for prod)
# DB_ENCRYPTION_KEY="your-32-character-encryption-key"

# ------------------------------------------------------------------------------
# 3. BACKGROUND TASKS & CACHING (Redis + Celery)
# ------------------------------------------------------------------------------
# Required for Celery Beat 24/7 background monitors & scheduled publishing
REDIS_URL="redis://localhost:6379/0"

# ------------------------------------------------------------------------------
# 4. AI & LLM PROVIDERS
# ------------------------------------------------------------------------------
# Google Gemini (Default active provider)
GEMINI_API_KEY=""
DEFAULT_PROVIDER="gemini"
DEFAULT_MODEL="gemini-1.5-flash"

# Optional Frontier LLMs (Unlocked on Pro tier)
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GROQ_API_KEY="gsk_..."
# MISTRAL_API_KEY=""

# ------------------------------------------------------------------------------
# 5. OAUTH & PLATFORM INTEGRATIONS
# ------------------------------------------------------------------------------
# Google Cloud Console (for GA4 & Google Search Console data sync)
# Authorized redirect URI: http://localhost:8000/api/integrations/oauth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OAUTH_REDIRECT_URI="http://localhost:8000/api/integrations/oauth/callback"

# LinkedIn Developer Portal (for Thought Leadership publishing & carousels)
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Meta & Instagram Graph API (for Ads tracking & Instagram publishing)
# META_APP_ID=""
# META_APP_SECRET=""

# WhatsApp Business Cloud API (Meta Developer Portal)
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""

# ------------------------------------------------------------------------------
# 6. INDIAN PAYMENTS & GST INVOICING (Optional / Production)
# ------------------------------------------------------------------------------
# Razorpay / Cashfree API credentials for live UPI, RuPay, and Card processing
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# Your Business Details for 100% Compliant GST Invoices (18% ITC)
# COMPANY_LEGAL_NAME="StandBharat Technologies Pvt. Ltd."
# COMPANY_GSTIN="27AAAAA0000A1Z5"
# COMPANY_ADDRESS="Bengaluru, Karnataka, India"

# ------------------------------------------------------------------------------
# 7. ASSET & DOCUMENT STORAGE (Local Storage vs S3/R2)
# ------------------------------------------------------------------------------
STORAGE_BACKEND="local"
STORAGE_LOCAL_ROOT="storage/documents"
# S3_BUCKET_NAME=""
# S3_REGION_NAME="ap-south-1"  # Mumbai AWS region
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
